<div class="min-h-screen bg-slate-100">
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-4xl font-black tracking-tight">Update <%= @arena.name %></h1>
        <p class="mt-2 text-slate-600">Edit your visit details or change the arena status.</p>
      </div>
      <%= link_to "Back to My Arenas", visits_path, class: "rounded-3xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
    </div>

    <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-lg">
      <div class="md:flex">
        <div class="md:w-1/3 bg-slate-950 p-8 text-white">
          <% if arena_image_for(@arena).present? %>
            <%= image_tag arena_image_for(@arena), alt: @arena.name, class: "h-56 w-full rounded-3xl object-cover" %>
          <% else %>
            <div class="flex h-56 items-center justify-center rounded-3xl bg-slate-800 text-slate-400">No image</div>
          <% end %>

          <div class="mt-6 space-y-3">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-400">Arena</p>
            <h2 class="text-2xl font-bold"><%= @arena.name %></h2>
            <p class="text-slate-300"><%= @arena.team.name %></p>
            <p class="text-slate-400"><%= @arena.city %>, <%= @arena.state %></p>
          </div>
        </div>

        <div class="md:w-2/3 p-8">
          <%= render "form", visit: @visit, submit_text: "Update arena" %>
        </div>
      </div>
    </div>
  </div>
</div>
