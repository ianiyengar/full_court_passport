<div class="min-h-screen bg-slate-100">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-4xl font-black tracking-tight text-slate-900">My Arenas</h1>
        <p class="mt-2 text-slate-600">Track the arenas you know, want to visit, and the notes that matter most.</p>
      </div>
      <%= link_to "Add another arena", root_path, class: "rounded-3xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400" %>
    </div>

    <% if @visits.any? %>
      <div class="space-y-6">
        <% @visits.each do |visit| %>
          <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
            <div class="grid gap-6 p-6 md:grid-cols-[1fr_0.9fr] lg:grid-cols-[1fr_0.8fr_0.7fr]">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-500"><%= visit.status.humanize %></p>
                <h2 class="mt-2 text-2xl font-bold text-slate-900"><%= link_to visit.arena.name, arena_path(visit.arena), class: "hover:text-emerald-500" %></h2>
                <p class="mt-2 text-slate-600"><%= visit.arena.team.name %> · <%= visit.arena.city %>, <%= visit.arena.state %></p>
                <p class="mt-3"><%= link_to "Edit details", edit_visit_path(visit), class: "text-sm font-semibold text-emerald-600 hover:underline" %></p>
                  <p class="text-sm text-slate-500"><span class="font-semibold text-slate-700">Game date:</span> <%= visit.game_date.strftime("%B %-d, %Y") %></p>
                <% end %>
                <% if visit.score_url.present? %>
                  <p class="text-sm"><span class="font-semibold text-slate-700">Score link:</span> <%= link_to "View stats", visit.score_url, class: "text-emerald-600 hover:underline", target: "_blank", rel: "noreferrer" %></p>
                <% end %>
              </div>

              <div class="space-y-3">
                <% if visit.notes.present? %>
                  <div>
                    <p class="text-sm font-semibold text-slate-700">Notes</p>
                    <p class="mt-2 text-slate-600"><%= visit.notes %></p>
                  </div>
                <% end %>
                <% if visit.concessions.present? %>
                  <div>
                    <p class="text-sm font-semibold text-slate-700">Concessions</p>
                    <p class="mt-2 text-slate-600"><%= visit.concessions %></p>
                  </div>
                <% end %>
                <% if visit.favorite_spots.present? %>
                  <div>
                    <p class="text-sm font-semibold text-slate-700">Favorite spots</p>
                    <p class="mt-2 text-slate-600"><%= visit.favorite_spots %></p>
                  </div>
                <% end %>
                <% if visit.photo_url.present? %>
                  <p class="text-sm"><span class="font-semibold text-slate-700">Photo</span>: <%= link_to "Open image", visit.photo_url, target: "_blank", rel: "noreferrer", class: "text-emerald-600 hover:underline" %></p>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-[2rem] border border-slate-200 bg-white p-10 text-center shadow-sm">
        <h2 class="text-3xl font-bold text-slate-900">No arenas saved yet</h2>
        <p class="mt-3 text-slate-600">Hit the button above to start adding arenas you have visited or want to visit.</p>
      </div>
    <% end %>
  </div>
</div>
