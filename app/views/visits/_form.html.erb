<%= form_with model: visit, local: true do |form| %>
  <%= form.hidden_field :arena_id %>

  <div class="space-y-6">
    <div class="grid gap-4 md:grid-cols-2">
      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-700">Mark this arena as</p>
        <div class="mt-4 space-y-3">
          <label class="flex items-center gap-3 rounded-2xl border border-slate-300 bg-white px-4 py-3">
            <%= form.radio_button :status, "visited", class: "h-4 w-4 text-emerald-600" %>
            <span>Visited</span>
          </label>
          <label class="flex items-center gap-3 rounded-2xl border border-slate-300 bg-white px-4 py-3">
            <%= form.radio_button :status, "want_to_visit", class: "h-4 w-4 text-emerald-600" %>
            <span>Want to visit</span>
          </label>
        </div>
      </div>

      <div class="rounded-3xl border border-slate-200 bg-slate-50 p-5 shadow-sm">
        <p class="text-sm font-semibold text-slate-700">Game date</p>
        <%= form.date_field :game_date, class: "mt-3 block w-full rounded-2xl border border-slate-300 bg-white px-4 py-3 text-slate-900" %>
        <p class="mt-3 text-sm text-slate-500">Optional: the day you visited or plan to visit.</p>
      </div>
    </div>

    <div class="grid gap-4">
      <div>
        <%= form.label :notes, "Notes", class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :notes, rows: 4, class: "mt-2 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-slate-900" %>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <%= form.label :concessions, "Concessions", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_area :concessions, rows: 3, class: "mt-2 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-slate-900" %>
        </div>
        <div>
          <%= form.label :favorite_spots, "Favorite spots", class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_area :favorite_spots, rows: 3, class: "mt-2 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-slate-900" %>
        </div>
      </div>

      <div class="grid gap-4 md:grid-cols-2">
        <div>
          <%= form.label :score_url, "Game score / stats URL", class: "block text-sm font-medium text-slate-700" %>
          <%= form.url_field :score_url, class: "mt-2 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-slate-900" %>
        </div>
        <div>
          <%= form.label :photo_url, "Photo URL", class: "block text-sm font-medium text-slate-700" %>
          <%= form.url_field :photo_url, class: "mt-2 block w-full rounded-3xl border border-slate-300 bg-white px-4 py-3 text-slate-900" %>
        </div>
      </div>
    </div>

    <div class="pt-4">
      <%= form.submit submit_text, class: "inline-flex w-full items-center justify-center rounded-3xl bg-emerald-500 px-6 py-4 text-base font-semibold text-slate-950 shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-400" %>
    </div>
  </div>
<% end %>
