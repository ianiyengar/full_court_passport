<div class="min-h-screen bg-slate-950 text-white">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 class="text-4xl font-black tracking-tight">Nearest arena found</h1>
        <p class="mt-2 text-slate-300">Based on <%= @home_city.present? ? "#{@home_city}, #{@home_state}" : @home_state %><%= @home_zip.present? ? ", ZIP #{@home_zip}" : "" %>.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Start over", root_path, class: "rounded-3xl border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-white/20" %>
        <%= link_to "Choose team directly", choose_team_path, class: "rounded-3xl bg-emerald-500 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-emerald-400" %>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr]">
      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/95 p-8 shadow-2xl shadow-black/20">
        <div class="flex flex-col gap-4">
          <div class="rounded-3xl overflow-hidden bg-slate-800">
            <% if arena_image_for(@nearest_arena).present? %>
              <%= image_tag arena_image_for(@nearest_arena), alt: @nearest_arena.name, class: "h-72 w-full object-cover" %>
            <% else %>
              <div class="flex h-72 items-center justify-center text-slate-500">No image available</div>
            <% end %>
          </div>

          <div>
            <h2 class="text-3xl font-bold text-white"><%= @nearest_arena.name %></h2>
            <p class="mt-2 text-slate-400"><%= @nearest_arena.team.name %> · <%= @nearest_arena.city %>, <%= @nearest_arena.state %></p>
          </div>

          <div class="grid gap-3 rounded-3xl border border-slate-700 bg-slate-950/80 p-6">
            <p><span class="font-semibold text-slate-200">Capacity:</span> <%= number_with_delimiter(@nearest_arena.capacity) %></p>
            <p><span class="font-semibold text-slate-200">First NBA season:</span> <%= @nearest_arena.first_nba_season %></p>
          </div>
        </div>
      </div>

      <div class="rounded-[2rem] border border-slate-700 bg-slate-900/95 p-8 shadow-2xl shadow-black/20">
        <h2 class="text-2xl font-semibold text-white">Is this your home arena?</h2>
        <p class="mt-3 text-slate-400">If it is, we’ll add it to your arena list and let you mark whether you visited or want to visit.</p>

        <div class="mt-8 flex flex-col gap-4">
          <%= link_to "Yes, this is my arena", new_visit_path(arena_id: @nearest_arena.id), class: "rounded-3xl bg-emerald-500 px-6 py-4 text-center text-base font-semibold text-slate-950 shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-400" %>
          <%= link_to "No, choose my team", choose_team_path, class: "rounded-3xl border border-slate-700 bg-slate-950/80 px-6 py-4 text-center text-base font-semibold text-white transition hover:border-white/20" %>
        </div>

        <div class="mt-10 rounded-3xl border border-slate-700 bg-slate-950/80 p-6 text-slate-300">
          <p class="font-semibold text-slate-100">What happens next</p>
          <p class="mt-3 text-sm leading-6">If you confirm this arena, you can immediately mark it as visited or want to visit. If not, pick your team and we’ll take you to your team’s arena.</p>
        </div>
      </div>
    </div>
  </div>
</div>
